# Copy this file to `.env` and fill in real values.
# All public variables MUST start with VITE_ to be exposed to the client.

# Local dev: leave unset; requests go to /api and the Vite proxy forwards them
# to VITE_PROXY_TARGET (default: the staging backend). Deployed builds: set the
# full backend URL, e.g. https://srt-backend-m5mc.onrender.com/api
VITE_API_BASE_URL=
# VITE_PROXY_TARGET=https://srt-backend-m5mc.onrender.com

# Platform tenant organisation the talent signs up under (staging: Ghana Talent Hub)
VITE_TENANT_ORG_ID=6a75ffc845ee5b96efa18a06
VITE_APP_NAME=TalentHub
# Career Buddy V2 (live agent). 1 = talents get the live agent on
# /profile/filling/career-buddy (?live=0 forces the scripted demo; ?live=1
# forces live when this is unset). Local dev reaches the agent through the
# Vite proxy at /agent -> VITE_AGENT_PROXY_TARGET (default http://localhost:4111).
VITE_CAREER_BUDDY_LIVE=
# VITE_AGENT_PROXY_TARGET=http://localhost:4111
# Deployed builds only (needs a backend proxy that checks the JWT - not done yet):
# VITE_AGENT_BASE_URL=
